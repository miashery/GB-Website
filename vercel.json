{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/journal-sitemap.xml",
      "destination": "https://webapp.gigglesbloom.com/journal-sitemap.xml"
    },
    {
      "source": "/journal/:slug",
      "destination": "https://webapp.gigglesbloom.com/journal/:slug"
    },
    {
      "source": "/workshops/:id",
      "destination": "https://webapp.gigglesbloom.com/workshops/:id"
    },
    {
      "source": "/workshops/:id/companion",
      "destination": "https://webapp.gigglesbloom.com/workshops/:id/companion"
    },
    {
      "source": "/api/public/workshop-companion/:path*",
      "destination": "https://webapp.gigglesbloom.com/api/public/workshop-companion/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://webapp.gigglesbloom.com/_next/:path*"
    },
    {
      "source": "/brand/:path*",
      "destination": "https://webapp.gigglesbloom.com/brand/:path*"
    },
    {
      "source": "/favicon.svg",
      "destination": "https://webapp.gigglesbloom.com/favicon.svg"
    },
    {
      "source": "/icon.svg",
      "destination": "https://webapp.gigglesbloom.com/icon.svg"
    }
  ]
}
